{
  "name": "awesome-video-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "cf.awesome.video", "custom_domain": true }],
  "containers": [
    {
      "class_name": "AwesomeVideoApp",
      // Built from the repo Dockerfile by deploy/cloudflare/release.sh, which
      // rewrites this tag to the 8-char commit it built. It uses the
      // development Clerk key and an empty VITE_CLERK_PROXY_URL: Clerk rejects
      // proxied Frontend API calls for development instances, and a pk_live
      // key would derive a nonexistent clerk.cf.awesome.video.
      "image": "registry.cloudflare.com/24080dbbce9363d385fac0500c121b85/awesome-video-cf:260cf674",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "AwesomeVideoApp", "name": "APP" }]
  },
  "migrations": [{ "new_sqlite_classes": ["AwesomeVideoApp"], "tag": "v1" }]
}
