{
  "name": "awesome-video-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "cf.awesome.video", "custom_domain": true }],
  "containers": [
    {
      "class_name": "AwesomeVideoApp",
      // Built from the repo Dockerfile by deploy/cloudflare/release.sh, which
      // rewrites this tag to the 8-char commit it built. cf's production
      // identity is the sk_test/pk_test Clerk instance (owner decision), so
      // VITE_CLERK_PROXY_URL stays empty: Clerk rejects proxied Frontend API
      // calls for development-type instances.
      "image": "registry.cloudflare.com/24080dbbce9363d385fac0500c121b85/awesome-video-cf:92391572",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "AwesomeVideoApp", "name": "APP" }]
  },
  "migrations": [{ "new_sqlite_classes": ["AwesomeVideoApp"], "tag": "v1" }]
}
