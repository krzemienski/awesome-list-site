{
  "schemaVersion": 2,
  "kind": "family",
  "family": "shell",
  "summary": "App shell states: header, sidebar, command palette, mobile drawer and error shells.",
  "screens": [
    {
      "id": "app.shell.default",
      "kind": "app",
      "eligibility": "pixel",
      "aliasOf": "app.home.index"
    },
    {
      "id": "app.shell.palette",
      "kind": "app",
      "eligibility": "pixel",
      "actualPath": "/",
      "referencePath": "/index.html",
      "actualAction": "palette",
      "referenceAction": "palette",
      "actualReadySelector": "[role=dialog]",
      "referenceReadySelector": ".modal-backdrop"
    },
    {
      "id": "app.shell.mobile-drawer",
      "kind": "app",
      "eligibility": "pixel",
      "widths": [375],
      "actualPath": "/",
      "referencePath": "/index.html",
      "actualAction": "mobile-drawer",
      "referenceAction": "mobile-drawer",
      "actualReadySelector": "[role=dialog]",
      "referenceReadySelector": ".mobile-drawer.open"
    },
    {
      "id": "app.not-found",
      "kind": "app",
      "eligibility": "blocked",
      "actualPath": "/__parity-not-found__",
      "reason": "The active modular reference does not expose a 404 state."
    },
    {
      "id": "app.error.loading",
      "kind": "app",
      "eligibility": "token-only",
      "reason": "Loading skeletons are transient; verified through skeleton tokens, not pixels."
    },
    {
      "id": "app.error.empty",
      "kind": "app",
      "eligibility": "token-only",
      "reason": "Empty states need an empty catalog slice; verified through empty-state tokens, not pixels."
    },
    {
      "id": "app.error.route",
      "kind": "app",
      "eligibility": "token-only",
      "reason": "Error injection is prohibited; no naturally occurring real error state is supplied."
    }
  ]
}
