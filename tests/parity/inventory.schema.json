{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesome.video/parity/inventory.schema.json",
  "title": "Parity inventory fragment",
  "description": "Structural contract for tests/parity/inventory/*.json. Cross-field rules (required fields per eligibility, alias targets, duplicate ids) live in tests/parity/inventory.mjs and run on every load.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "kind": {
          "type": "string",
          "const": "config"
        },
        "widths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number",
                "const": 375
              },
              {
                "type": "number",
                "const": 768
              },
              {
                "type": "number",
                "const": 1024
              },
              {
                "type": "number",
                "const": 1440
              }
            ]
          }
        },
        "viewportHeights": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(375|768|1024|1440)$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 600,
            "maximum": 1200
          }
        },
        "sourceInventoryProvenance": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "sourceInventoryAliases": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(app|artifact)(\\.[a-z0-9-]+)+$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "widths",
        "viewportHeights",
        "sourceInventoryProvenance",
        "sourceInventoryAliases"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "kind": {
          "type": "string",
          "const": "family"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 8
        },
        "screens": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(app|artifact)(\\.[a-z0-9-]+)+$",
                "description": "Stable row id: <kind>.<family>[.<state>]"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "app",
                  "artifact"
                ],
                "description": "Which local target serves actualPath: the app (5000) or the design-system artifact"
              },
              "eligibility": {
                "type": "string",
                "enum": [
                  "pixel",
                  "token-only",
                  "artifact-docs",
                  "blocked"
                ],
                "description": "pixel | token-only | artifact-docs | blocked"
              },
              "widths": {
                "description": "Subset of the configured widths; omit for all four",
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 375
                    },
                    {
                      "type": "number",
                      "const": 768
                    },
                    {
                      "type": "number",
                      "const": 1024
                    },
                    {
                      "type": "number",
                      "const": 1440
                    }
                  ]
                }
              },
              "actualPath": {
                "description": "Path on the actual target; {categorySlug} {subcategorySlug} {subSubcategorySlug} {resourceId} are resolved from the live catalog",
                "type": "string",
                "pattern": "^\\/[^\\s]*$"
              },
              "referencePath": {
                "description": "Path inside awesome-list-site-ds served from the in-memory snapshot",
                "type": "string",
                "pattern": "^\\/[^\\s]*$"
              },
              "actualAction": {
                "description": "Action id applied on the actual page before settling (see runner ACTIONS)",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9-]+)?$"
              },
              "referenceAction": {
                "description": "Action id applied on the reference page before settling",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9-]+)?$"
              },
              "actualReadySelector": {
                "type": "string",
                "minLength": 1
              },
              "referenceReadySelector": {
                "type": "string",
                "minLength": 1
              },
              "readySelector": {
                "description": "Shared ready selector when both sides use the same one",
                "type": "string",
                "minLength": 1
              },
              "identityCheck": {
                "description": "Structural check that both pages show the same catalog entity before pixels are compared",
                "type": "string",
                "enum": [
                  "home",
                  "category",
                  "subcategory",
                  "subsubcategory",
                  "resource",
                  "admin-tab"
                ]
              },
              "requires": {
                "description": "Run preconditions; admin-session rows are BLOCKED (never PASS) when no disposable admin is available",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "admin-session"
                  ]
                }
              },
              "aliasOf": {
                "description": "This row is the same capture as another pixel row",
                "type": "string",
                "pattern": "^(app|artifact)(\\.[a-z0-9-]+)+$"
              },
              "reason": {
                "description": "Required for token-only, artifact-docs and blocked rows: why no pixel gate applies",
                "type": "string",
                "minLength": 12
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "eligibility"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "family",
        "summary",
        "screens"
      ],
      "additionalProperties": false
    }
  ]
}
