":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:30:22.765Z","metadata":{"tags":["CABR","video streaming","bitrate reduction","video quality","encoding"]},"createdAt":"2026-01-20T20:30:22.765Z"},{"id":184909,"title":"Bento","url":"https://github.com/bento-video/bento","description":"Bento is an open-source, high-speed serverless video transcoding pipeline designed for deployment on Amazon Web Services (AWS). It offers a fast and simple solution for individuals and small businesses needing efficient video transcoding capabilities.","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:30:00.727Z","metadata":{"tags":["serverless","video","transcoding","AWS","pipeline"]},"createdAt":"2026-01-20T20:30:00.727Z"},{"id":185037,"title":"Bitrate Viewer","url":"https://www.winhoros.de/docs/bitrate-viewer/","description":"Bitrate Viewer is a free Windows application that allows users to analyze the bitrate of H.264 encoded video files. It provides a graphical representation of bitrate distribution, aiding in the assessment of video quality and encoding efficiency.","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:30:06.131Z","metadata":{"tags":["bitrate analysis","H.264","video quality","Windows","freeware"]},"createdAt":"2026-01-20T20:30:06.131Z"},{"id":186674,"title":"CineForm SDK","url":"https://gopro.github.io/cineform-sdk/","description":"GoPro’s CineForm codec SDK, open-sourced, providing tools and libraries for the CineForm HD wavelet-based video codec used for high-fidelity video compression.","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:31:16.701Z","metadata":{"tags":["codec","SDK","compression","video encoding","gopro"]},"createdAt":"2026-01-20T20:31:16.701Z"},{"id":186487,"title":"Cisco Thor Video Codec","url":"https://tools.ietf.org/html/draft-fuldseth-netvc-thor-00","description":"Thor was an experimental video codec developed by Cisco as a candidate for the NETVC (Next-Gen Video) initiative. While Thor itself is not used as-is, some of its technology contributed to the development of AV1. It's a piece of codec research history with source available for study.","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:31:08.051Z","metadata":{},"createdAt":"2026-01-20T20:31:08.051Z"},{"id":184956,"title":"CompressAI","url":"https://arxiv.org/abs/2011.03029","description":"CompressAI is a PyTorch library and evaluation platform for end-to-end compression research. It provides custom operations, layers, models, and tools to research, develop, and evaluate image and video compression codecs. CompressAI includes pre-trained models and evaluation tools to compare learned methods with traditional codecs, facilitating advancements in compression technology.","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:30:02.716Z","metadata":{"tags":["compression research","PyTorch","video encoding","evaluation platform","open-source"]},"createdAt":"2026-01-20T20:30:02.716Z"},{"id":185297,"title":"CrafyVideoJS","url":"https://github.com/chijete/CrafyVideoJS","description":"CrafyVideoJS is a lightweight, hardware-accelerated JavaScript library that enables in-browser manipulation, decoding, and encoding of MP4 H.264 (AVC) videos. It leverages the browser's VideoEncoder and VideoDecoder APIs along with mp4box.js to provide efficient video processing without server-side support. Features include video trimming, bitrate adjustment, resolution changes, and metadata extraction.","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:30:17.184Z","metadata":{"tags":["JavaScript","video processing","MP4","H.264","browser-based"]},"createdAt":"2026-01-20T20:30:17.184Z"},{"id":184769,"title":"DivX Converter","url":"https://www.divx.com/en/software/converter/","description":"DivX Converter is a video encoding software that allows users to compress and convert video files into the DivX digital format, known for its high-quality output and efficient compression.","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:29:54.774Z","metadata":{"tags":["video","compression","conversion","high-quality","efficient"]},"createdAt":"2026-01-20T20:29:54.774Z"},{"id":186258,"title":"Dolby Vision Professional Decoder Plugin","url":"https://github.com/DolbyLaboratories/dolby_vision_professional_decoder_plugin","description":"DolbyLaboratories/dolby_vision_professional_decoder_plugin - A GitHub repository for video/multimedia development","category":"Encoding & Codecs","subcategory":null,"subSubcategory":null,"resourceFormat":"unknown","provider":"unknown","skillLevel":"unknown","status":"approved","contributorRejectionReason":null,"statusChangedAt":"2026-01-20T20:30:57.900Z","metadata":{},"createdA