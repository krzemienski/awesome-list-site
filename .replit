[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Restart"
mode = "sequential"
author = 17784443

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "migration-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/check-migration-drift.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "print-audit"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/print-audit.mjs"

[[workflows.workflow]]
name = "responsive-audit"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/responsive-audit.mjs"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mockup-sandbox && PORT=23636 BASE_PATH=/__mockup/ npm run dev"
waitForPort = 23636

[workflows.workflow.metadata]
outputType = "console"
isCanvasWorkflow = true

[[workflows.workflow]]
name = "tablet-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/tablet-audit.mjs"

[workflows.workflow.metadata]
outputType = "console"
isValidation = true

[[workflows.workflow]]
name = "url-params-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/url-params-audit.mjs"

[[workflows.workflow]]
name = "collections-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/collections-audit.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task302-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task302-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task302-boot-safety"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-boot-migration-safety.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task302-resilience"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 90 && BASE_URL=http://127.0.0.1:5000 npm run validate:resilience"

[[workflows.workflow]]
name = "openapi-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run validate:openapi"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "prefs-revision-races"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/validation/preferences-revision-races.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "response-contract-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run validate:response-contracts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "seo-snapshot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/seo-snapshot.mjs --gate --parity"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "taxonomy-listing-parity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/taxonomy-listing-parity.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "taxonomy-no-corpus-fetch"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/validation/taxonomy-no-corpus-fetch.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cache-headers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build && node scripts/validation/http-cache-headers.mjs --spawn"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pool-probe"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PROBE_ROUNDS=3 PROBE_CONCURRENCY=20 npm run validate:pool"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "search-typos"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run validate:search-typos"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_google_analytics:1.0.0", "javascript_anthropic:1.0.0", "javascript_anthropic_ai_integrations:1.0.0", "javascript_log_in_with_replit:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_SITE_URL = "https://awesome.video"
