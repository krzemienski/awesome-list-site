modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq", "chromium", "glib", "nss", "nspr", "atk", "cups", "libdrm", "libxkbcommon", "mesa", "alsa-lib", "xorg.libxcb", "xorg.libX11", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXtst", "xorg.libXScrnSaver", "gtk3", "pango", "cairo", "gdk-pixbuf", "dbus", "expat", "gtk4", "vulkan-loader", "graphene", "icu74", "gcc-unwrapped", "libxml2", "sqlite", "libxslt", "lcms2", "libevent", "libopus", "flite", "libwebp", "libavif", "harfbuzzFull", "libepoxy", "libjpeg8", "libmanette", "enchant", "hyphen", "libsecret", "woff2", "libglvnd", "x264", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-good", "gst_all_1.gst-plugins-bad", "gst_all_1.gst-plugins-ugly", "gst_all_1.gst-libav", "glib-networking"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/publish-build.sh"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5051
externalPort = 3003

[[ports]]
localPort = 5052
externalPort = 4200

[[ports]]
localPort = 5053
externalPort = 5000

[[ports]]
localPort = 5055
externalPort = 3000

[[ports]]
localPort = 5056
externalPort = 6000

[[ports]]
localPort = 5057
externalPort = 6800

[[ports]]
localPort = 5071
externalPort = 5173

[[ports]]
localPort = 5093
externalPort = 3001

[[ports]]
localPort = 20928
externalPort = 3002

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Restart"
mode = "sequential"
author = 17784443

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[agent]
integrations = ["javascript_google_analytics:1.0.0", "javascript_anthropic:1.0.0", "javascript_anthropic_ai_integrations:1.0.0", "javascript_log_in_with_replit:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[userenv]

[userenv.shared]
VITE_SITE_URL = "https://awesome.video"
ANTHROPIC_BASE_URL = "https://router.hack.ski"
ANTHROPIC_DEFAULT_FABLE_MODEL = "cc/claude-fable-5"
ANTHROPIC_DEFAULT_HAIKU_MODEL = "cc/claude-haiku-4-5-20251001"
ANTHROPIC_DEFAULT_OPUS_MODEL = "cc/claude-opus-5"
ANTHROPIC_DEFAULT_SONNET_MODEL = "cc/claude-sonnet-5"
ANTHROPIC_MODEL = "cc/claude-opus-5"
CONTACT_ISSUES_URL = "https://github.com/krzemienski/awesome-video/issues"
CONTACT_ENABLED = "true"
VITE_CONTACT_VARIANT = "b"

[userenv.development]

[userenv.production]
REPLIT_PUBLISH_IMAGE_TRIM = "1"
