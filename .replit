modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq", "chromium", "glib", "nss", "nspr", "atk", "cups", "libdrm", "libxkbcommon", "mesa", "alsa-lib", "xorg.libxcb", "xorg.libX11", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXtst", "xorg.libXScrnSaver", "gtk3", "pango", "cairo", "gdk-pixbuf", "dbus", "expat"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/pre-publish-gate.sh", "--publish"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5093
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migration-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "print-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "responsive-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mockup-sandbox: Component Preview Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tablet-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "url-params-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "collections-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task302-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task302-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task302-boot-safety"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task302-resilience"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "openapi-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prefs-revision-races"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "response-contract-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seo-snapshot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "taxonomy-listing-parity"

