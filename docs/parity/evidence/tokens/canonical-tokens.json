{
  "source": [
    "awesome-list-site-ds/styles.css",
    "awesome-list-site-ds/design-systems.jsx",
    "awesome-list-site-ds/app.jsx",
    "awesome-list-site-ds/layout.jsx"
  ],
  "root": {
    "--bg": "#000",
    "--bg-2": "#0a0a0a",
    "--surface": "rgba(255,255,255,0.025)",
    "--surface-2": "rgba(255,255,255,0.05)",
    "--surface-3": "rgba(255,255,255,0.08)",
    "--border": "rgba(255,255,255,0.08)",
    "--border-strong": "rgba(255,255,255,0.16)",
    "--hairline": "rgba(255,255,255,0.06)",
    "--text": "#f4f3ee",
    "--text-2": "rgba(244,243,238,0.66)",
    "--text-3": "rgba(244,243,238,0.4)",
    "--text-4": "rgba(244,243,238,0.22)",
    "--accent": "#ff3d52",
    "--accent-2": "#b84dff",
    "--font-body": "'Inter', system-ui, sans-serif",
    "--font-display": "'Fraunces', Georgia, serif",
    "--font-mono": "'JetBrains Mono', ui-monospace, monospace",
    "--display-weight": "500",
    "--display-tracking": "-0.02em",
    "--display-leading": "1.04",
    "--body-leading": "1.6",
    "--eyebrow-tracking": "0.18em",
    "--mono-size-step": "11px",
    "--radius": "12px",
    "--radius-sm": "8px",
    "--radius-pill": "999px",
    "--border-w": "1px",
    "--hairline-w": "1px",
    "--shadow-sm": "0 1px 2px rgba(0,0,0,0.3)",
    "--shadow": "0 6px 24px -8px rgba(0,0,0,0.5)",
    "--shadow-lg": "0 24px 60px -20px rgba(0,0,0,0.7)",
    "--shadow-accent": "0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent), 0 12px 36px -12px color-mix(in srgb, var(--accent) 40%, transparent)",
    "--bg-atmosphere": "none",
    "--bg-atmosphere-size": "auto",
    "--grain-opacity": "0.32"
  },
  "geometry": {
    "--shell-sidebar-w": "280px",
    "--shell-sidebar-w-tablet": "240px",
    "--shell-rail-w": "56px",
    "--shell-header-h": "60px",
    "--page-pad-y": "48px",
    "--page-pad-x": "40px",
    "--content-max": "1240px",
    "--content-max-admin": "1400px",
    "--footer-pad": "48px 40px 32px"
  },
  "responsive": [
    {
      "token": "--shell-sidebar-w",
      "context": "@media (min-width: 768px) and (max-width: 1023px)",
      "value": "240px",
      "note": "tablet 768–1023: the sidebar narrows to the design's tablet .sidebar width"
    },
    {
      "token": "--shell-header-h",
      "context": "@media (max-width: 767px)",
      "value": "56px",
      "note": "mobile <768: the header drops to the design's mobile .header height"
    }
  ],
  "utilities": {
    ".page": {
      "position": "relative",
      "min-height": "100vh",
      "background": "var(--bg-atmosphere), var(--bg)",
      "background-size": "var(--bg-atmosphere-size, auto), auto",
      "background-color": "var(--bg)"
    },
    ".grain": {
      "position": "fixed",
      "inset": "0",
      "pointer-events": "none",
      "z-index": "1",
      "opacity": "var(--grain-opacity, 0.32)",
      "mix-blend-mode": "overlay",
      "background-image": "url(\"data:image/svg+xml;base64,\")"
    },
    ".mono": {
      "font-family": "var(--font-mono)"
    },
    ".display": {
      "font-family": "var(--font-display)"
    },
    ".serif-italic": {
      "font-family": "var(--font-display)",
      "font-style": "italic",
      "font-weight": "400"
    },
    ".display-h": {
      "font-family": "var(--font-display)",
      "font-weight": "var(--display-weight)",
      "letter-spacing": "var(--display-tracking)",
      "line-height": "var(--display-leading)"
    },
    ".card": {
      "background": "var(--surface)",
      "border": "var(--border-w) solid var(--border)",
      "border-radius": "var(--radius)",
      "transition": "transform 220ms cubic-bezier(0.2, 0.65, 0.3, 1),\n              background 220ms ease,\n              border-color 220ms ease,\n              box-shadow 220ms ease",
      "position": "relative"
    },
    ".card.hoverable": {
      "cursor": "pointer"
    },
    ".card.hoverable:hover": {
      "transform": "translateY(-2px)",
      "border-color": "var(--border-strong)",
      "background": "var(--surface-2)",
      "box-shadow": "var(--shadow)"
    },
    ".card.glow:hover": {
      "box-shadow": "var(--shadow-accent)"
    },
    ".chip": {
      "display": "inline-flex",
      "align-items": "center",
      "gap": "6px",
      "padding": "4px 10px",
      "border-radius": "var(--radius-pill)",
      "background": "var(--surface)",
      "border": "var(--hairline-w) solid var(--border)",
      "font-family": "var(--font-mono)",
      "font-size": "10.5px",
      "letter-spacing": "0.6px",
      "color": "var(--text-2)",
      "text-transform": "uppercase",
      "white-space": "nowrap"
    },
    ".chip.accent": {
      "color": "var(--accent)",
      "border-color": "color-mix(in srgb, var(--accent) 35%, var(--border))",
      "background": "color-mix(in srgb, var(--accent) 8%, transparent)"
    },
    ".chip.ok": {
      "color": "#34d08c",
      "border-color": "rgba(52,208,140,0.3)",
      "background": "rgba(52,208,140,0.08)"
    },
    ".chip.warn": {
      "color": "#ffb84d",
      "border-color": "rgba(255,184,77,0.3)",
      "background": "rgba(255,184,77,0.08)"
    },
    ".chip.bad": {
      "color": "#ff5c7a",
      "border-color": "rgba(255,92,122,0.3)",
      "background": "rgba(255,92,122,0.08)"
    },
    ".chip.muted": {
      "color": "var(--text-3)"
    },
    ".dot": {
      "width": "8px",
      "height": "8px",
      "border-radius": "50%",
      "display": "inline-block"
    },
    ".dot.ok": {
      "background": "#34d08c",
      "box-shadow": "0 0 8px #34d08c"
    },
    ".dot.warn": {
      "background": "#ffb84d"
    },
    ".dot.bad": {
      "background": "#ff5c7a"
    },
    ".eyebrow": {
      "font-family": "var(--font-mono)",
      "font-size": "var(--mono-size-step)",
      "letter-spacing": "var(--eyebrow-tracking)",
      "text-transform": "uppercase",
      "color": "var(--accent)",
      "display": "inline-flex",
      "align-items": "center",
      "gap": "8px",
      "font-weight": "600"
    },
    ".kbd": {
      "font-family": "var(--font-mono)",
      "font-size": "10.5px",
      "color": "var(--text-3)",
      "padding": "2px 6px",
      "border": "var(--hairline-w) solid var(--border)",
      "border-radius": "4px",
      "background": "var(--surface)"
    },
    "@media (max-width: 768px)||.hide-mobile": {
      "display": "none !important"
    },
    "@media (min-width: 769px)||.show-mobile": {
      "display": "none !important"
    },
    "@media (max-width: 1024px)||.hide-tablet": {
      "display": "none !important"
    },
    "@media (min-width: 1025px)||.show-tablet": {
      "display": "none !important"
    }
  },
